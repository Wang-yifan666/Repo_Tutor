{
  "name": "repo-tutor-dsh",
  "version": "0.1.0-rc.1",
  "description": "Interactive repository tutor for DSH: a C++ teaching state machine (Learning Units, evidence budget, frozen question snapshots) behind tutor tools and a Tutor agent mode.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./policies/tutor-prompt.md": "./policies/tutor-prompt.md",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "repo-tutor-dsh": "scripts/install-preset.mjs"
  },
  "files": [
    "src",
    "policies",
    "preset",
    "scripts",
    "cordis.patch.yml",
    "platforms.config.json",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "keywords": [
    "dsh",
    "dsh-bundle",
    "cordis",
    "cordis-plugin",
    "tutor",
    "teaching",
    "codebase-onboarding",
    "mental-model"
  ],
  "license": "MIT",
  "author": "Wang-yifan666 (https://github.com/Wang-yifan666)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wang-yifan666/Repo_Tutor.git",
    "directory": "hosts/dsh"
  },
  "homepage": "https://github.com/Wang-yifan666/Repo_Tutor#readme",
  "bugs": {
    "url": "https://github.com/Wang-yifan666/Repo_Tutor/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.6-alpha.1 <0.2.0 || >=0.2.3-alpha.2 <0.3.0"
  },
  "scripts": {
    "verify": "node scripts/verify-package.mjs",
    "platforms": "node scripts/make-platform-packages.mjs",
    "check": "node scripts/release-check.mjs"
  },
  "repoTutor": {
    "protocolVersion": "0.1",
    "platformsConfig": "platforms.config.json"
  },
  "optionalDependencies": {
    "@repo-tutor/core-win32-x64": "0.1.0-rc.1",
    "@repo-tutor/core-linux-x64": "0.1.0-rc.1"
  },
  "publishConfig": {
    "tag": "next",
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
