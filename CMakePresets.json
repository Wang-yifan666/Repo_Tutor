{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Dev（默认 generator）",
      "description": "使用 CMake 的平台默认 generator（例如 Linux/macOS 上的 Unix Makefiles）。",
      "binaryDir": "${sourceDir}/build/dev"
    },
    {
      "name": "dev-mingw",
      "displayName": "Dev（MinGW Makefiles + clang++）",
      "description": "Windows/MinGW 运行时，用 clang++ 编译。本机 g++ 11.2.0 编标准库代码会 ICE，所以换 clang。",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/dev-mingw",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "--target=x86_64-w64-windows-gnu"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "dev-mingw",
      "configurePreset": "dev-mingw"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-mingw",
      "configurePreset": "dev-mingw",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
